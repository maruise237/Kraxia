# ============================================================
# Kraxia — variables d'environnement (Dokploy / Coolify / Docker)
# ============================================================
# Copier ce fichier :  cp .env.example .env
# Renseigner au minimum : JWT_SECRET, ADMIN_PASSWORD, ANTHROPIC_API_KEY

# ── Sécurité & compte administrateur initial ──────────────────
JWT_SECRET=changez-moi-en-production-au-moins-32-caracteres-aleatoires
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── Base PostgreSQL (interne au compose) ───────────────────────
POSTGRES_USER=kraxia
POSTGRES_PASSWORD=kraxia
POSTGRES_DB=kraxia_platform

# ── Ports hôtes exposés ───────────────────────────────────────
GATEWAY_PORT=8080
FRONTEND_PORT=3000

# ── Domaine & URL backend consommée par le frontend ───────────
# VITE_API_URL vide = même origine (reverse-proxy Traefik gère /api)
# Sinon renseigner l'URL absolue de la passerelle :
# VITE_API_URL=https://api.kraxia.example.com
VITE_API_URL=

# ── Modèle LLM par défaut ─────────────────────────────────────
DEFAULT_MODEL=dashscope/qwen3-coder-plus

# ── Clés API fournisseurs (laisser vide les non utilisés) ─────
# Anthropic (Claude)
ANTHROPIC_API_KEY=
# OpenAI
OPENAI_API_KEY=
OPENAI_API_BASE=
# DeepSeek
DEEPSEEK_API_KEY=
# OpenRouter (multi-modèles)
OPENROUTER_API_KEY=
# DashScope (Qwen)
DASHSCOPE_API_KEY=
# Minimax (modèles rapides)
MINIMAX_API_KEY=
MINIMAX_API_BASE=
# AiHubMix
AIHUBMIX_API_KEY=
# Evolink, Moonshot / Kimi, Zhipu, Doubao
EVOLINK_API_KEY=
MOONSHOT_API_KEY=
KIMI_API_KEY=
ZHIPU_API_KEY=
DOUBAO_API_KEY=

# ── Conteneurs utilisateur ────────────────────────────────────
PLATFORM_SHARED_OPENCLAW_ENABLED=true
CONTAINER_TZ=UTC
PLATFORM_CONTAINER_MEMORY_LIMIT=2g

# ── Fonctionnalités ───────────────────────────────────────────
PLATFORM_TRAINING_TRACE_ENABLED=false
